  void _mostrarFormularioNuevaOrden(BuildContext context) {
    final clienteController = TextEditingController();
    final telefonoController = TextEditingController();
    final cantidadController = TextEditingController(text: '1');
    final precioBaseController = TextEditingController();
    final envioController = TextEditingController(text: '0');
    final anticipoController = TextEditingController();
    
    ProductoBase? productoSeleccionado;
    String colorSeleccionado = '';
    String tallaSeleccionada = '';
    
    List<UbicacionLogoExtra> listaLogos = [];

    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      builder: (context) {
        return Padding(
          padding: EdgeInsets.only(bottom: MediaQuery.of(context).viewInsets.bottom, left: 16, right: 16, top: 16),
          child: StatefulBuilder(
            builder: (context, setStateModal) {
              
              void calcularTotalAutomatico(StateSetter setStateModal) {
                double base = double.tryParse(precioBaseController.text) ?? 0.0;
                int cant = int.tryParse(cantidadController.text) ?? 1;
                double extras = listaLogos.fold(0.0, (sum, l) => sum + l.costoExtra);
                double envio = double.tryParse(envioController.text) ?? 0.0;
                
                // Total = (Precio Base + Extras por prenda) * Cantidad + Envío
                double totalCalculado = ((base + extras) * cant) + envio;
                // Dejamos el campo listo o actualizamos valor
              }

              return SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text('Nueva Orden de Trabajo', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
                    TextField(controller: clienteController, decoration: const InputDecoration(labelText: 'Nombre del Cliente')),
                    TextField(controller: telefonoController, decoration: const InputDecoration(labelText: 'Teléfono (WhatsApp)'), keyboardType: TextInputType.phone),
                    
                    DropdownButtonFormField<ProductoBase>(
                      hint: const Text('Seleccionar Modelo de Prenda'),
                      items: inventario.map((p) => DropdownMenuItem(value: p, child: Text('${p.nombre} (Stock: ${p.stockGeneral})'))).toList(),
                      onChanged: (val) {
                        setStateModal(() {
                          productoSeleccionado = val;
                          if (val != null) {
                            if (val.coloresDisponibles.isNotEmpty) colorSeleccionado = val.coloresDisponibles.first;
                            if (val.tallasDisponibles.isNotEmpty) tallaSeleccionada = val.tallasDisponibles.first;
                            precioBaseController.text = val.precioBase.toString();
                          }
                        });
                      },
                    ),

                    if (productoSeleccionado != null) ...[
                      const SizedBox(height: 10),
                      Row(
                        children: [
                          Expanded(
                            child: DropdownButtonFormField<String>(
                              value: colorSeleccionado.isEmpty ? null : colorSeleccionado,
                              hint: const Text('Color'),
                              items: productoSeleccionado!.coloresDisponibles.map((c) => DropdownMenuItem(value: c, child: Text(c))).toList(),
                              onChanged: (val) => setStateModal(() => colorSeleccionado = val!),
                            ),
                          ),
                          const SizedBox(width: 10),
                          Expanded(
                            child: DropdownButtonFormField<String>(
                              value: tallaSeleccionada.isEmpty ? null : tallaSeleccionada,
                              hint: const Text('Talla'),
                              items: productoSeleccionado!.tallasDisponibles.map((t) => DropdownMenuItem(value: t, child: Text(t))).toList(),
                              onChanged: (val) => setStateModal(() => tallaSeleccionada = val!),
                            ),
                          ),
                        ],
                      ),
                    ],

                    Row(
                      children: [
                        Expanded(child: TextField(controller: cantidadController, decoration: const InputDecoration(labelText: 'Cantidad'), keyboardType: TextInputType.number)),
                        const SizedBox(width: 10),
                        Expanded(child: TextField(controller: precioBaseController, decoration: const InputDecoration(labelText: 'Precio Base Unitario \$'), keyboardType: TextInputType.number)),
                      ],
                    ),

                    const Divider(height: 30),
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        const Text('Logotipos / Nombres Extras', style: TextStyle(fontWeight: FontWeight.bold)),
                        IconButton(
                          icon: const Icon(Icons.add_circle, color: Colors.blue),
                          onPressed: () {
                            _mostrarDialogoAgregarLogo(context, setStateModal, listaLogos);
                          },
                        )
                      ],
                    ),
                    
                    ...listaLogos.asMap().entries.map((entry) {
                      int idx = entry.key;
                      var logo = entry.value;
                      return ListTile(
                        dense: true,
                        title: Text('${logo.ubicacion}: ${logo.descripcion}'),
                        subtitle: Text('Costo extra: \$${logo.costoExtra.toStringAsFixed(2)}'),
                        trailing: IconButton(
                          icon: const Icon(Icons.delete, color: Colors.red),
                          onPressed: () => setStateModal(() => listaLogos.removeAt(idx)),
                        ),
                      );
                    }),

                    const SizedBox(height: 10),
                    TextField(controller: envioController, decoration: const InputDecoration(labelText: 'Costo de Envío \$ (Opcional)'), keyboardType: TextInputType.number),
                    TextField(controller: anticipoController, decoration: const InputDecoration(labelText: 'Anticipo Recibido \$'), keyboardType: TextInputType.number),

                    const SizedBox(height: 20),
                    ElevatedButton(
                      onPressed: () {
                        if (clienteController.text.isEmpty || productoSeleccionado == null || cantidadController.text.isEmpty) return;
                        
                        int cant = int.parse(cantidadController.text);
                        double base = double.tryParse(precioBaseController.text) ?? 0.0;
                        double extras = listaLogos.fold(0.0, (sum, l) => sum + l.costoExtra);
                        double envio = double.tryParse(envioController.text) ?? 0.0;
                        double totalFinal = ((base + extras) * cant) + envio;
                        double ant = double.tryParse(anticipoController.text) ?? 0.0;

                        OrdenTrabajo nueva = OrdenTrabajo(
                          id: DateTime.now().millisecondsSinceEpoch.toString(),
                          cliente: clienteController.text,
                          telefono: telefonoController.text,
                          productoNombre: productoSeleccionado!.nombre,
                          colorSeleccionado: colorSeleccionado,
                          tallaSeleccionada: tallaSeleccionada,
                          cantidad: cant,
                          logotiposExtras: listaLogos,
                          precioBaseUnitario: base,
                          costoEnvio: envio,
                          total: totalFinal,
                          anticipo: ant,
                          estatusProduccion: 'En Producción',
                          estatusInventario: 'Surtido',
                          fecha: DateTime.now(),
                        );

                        onNuevaOrden(nueva, productoSeleccionado!);
                        Navigator.pop(context);
                        onActualizar();
                      },
                      style: ElevatedButton.styleFrom(minimumSize: const Size.fromHeight(45)),
                      child: const Text('Guardar Orden de Trabajo'),
                    ),
                    const SizedBox(height: 20),
                  ],
                ),
              );
            },
          ),
        );
      },
    );
  }

  void _mostrarDialogoAgregarLogo(BuildContext parentContext, StateSetter setStateModalPrincipal, List<UbicacionLogoExtra> listaLogos) {
    String ubicacion = 'Pecho';
    final descController = TextEditingController();
    final costoController = TextEditingController();
    String? imgPath;

    showDialog(
      context: parentContext,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setStateDialog) {
            return AlertDialog(
              title: const Text('Agregar Logo o Nombre Extra'),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    DropdownButtonFormField<String>(
                      value: ubicacion,
                      items: ['Pecho Izquierdo', 'Pecho Derecho', 'Espalda', 'Manga Izquierda', 'Manga Derecha', 'Nombre Personalizado'].map((u) => DropdownMenuItem(value: u, child: Text(u))).toList(),
                      onChanged: (val) => setStateDialog(() => ubicacion = val!),
                    ),
                    TextField(controller: descController, decoration: const InputDecoration(labelText: 'Descripción (ej. Logo color blanco + Nombre)')),
                    TextField(controller: costoController, decoration: const InputDecoration(labelText: 'Costo Extra \$ (por pieza)'), keyboardType: TextInputType.number),
                    const SizedBox(height: 10),
                    ElevatedButton.icon(
                      onPressed: () async {
                        final picker = ImagePicker();
                        final image = await picker.pickImage(source: ImageSource.gallery);
                        if (image != null) {
                          setStateDialog(() => imgPath = image.path);
                        }
                      },
                      icon: const Icon(Icons.camera_alt),
                      label: Text(imgPath == null ? 'Adjuntar Imagen de este Logo' : 'Imagen Adjunta ✓'),
                    ),
                  ],
                ),
              ),
              actions: [
                TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancelar')),
                ElevatedButton(
                  onPressed: () {
                    double costo = double.tryParse(costoController.text) ?? 0.0;
                    setStateModalPrincipal(() {
                      listaLogos.add(UbicacionLogoExtra(
                        ubicacion: ubicacion,
                        descripcion: descController.text.isEmpty ? ubicacion : descController.text,
                        costoExtra: costo,
                        imagenPath: imgPath,
                      ));
                    });
                    Navigator.pop(context);
                  },
                  child: const Text('Añadir'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  Future<void> _enviarWhatsApp(OrdenTrabajo orden) async {
    String resumenLogos = orden.logotiposExtras.map((l) => '• ${l.ubicacion}: ${l.descripcion}').join('\n');
    final String mensaje = '''
*UNITAP - Resumen de Pedido*
Hola *${orden.cliente}*, este es el detalle de tu orden:
• Prenda: ${orden.productoNombre} (${orden.colorSeleccionado}, Talla ${orden.tallaSeleccionada}) x ${orden.cantidad} pzas
Personalizaciones:
$resumenLogos
${orden.costoEnvio > 0 ? '• Envío: \$${orden.costoEnvio.toStringAsFixed(2)}\n' : ''}• Total: \$${orden.total.toStringAsFixed(2)}
• Anticipo: \$${orden.anticipo.toStringAsFixed(2)}
• Restante: \$${orden.restante.toStringAsFixed(2)}
''';
    final Uri url = Uri.parse('https://wa.me/${orden.telefono.replaceAll(RegExp(r'\D'), '')}?text=${Uri.encodeComponent(mensaje)}');
    if (await canLaunchUrl(url)) await launchUrl(url, mode: LaunchMode.externalApplication);
  }

  Future<void> _generarYCompartirPDF(OrdenTrabajo orden, DatosNegocio negocio) async {
    final pdf = pw.Document();

    pw.ImageProvider? logoNegocioImage;
    if (negocio.logoPath != null) {
      final file = File(negocio.logoPath!);
      if (file.existsSync()) logoNegocioImage = pw.MemoryImage(file.readAsBytesSync());
    }

    // HOJA 1: NOTA DE PEDIDO Y FINANZAS
    pdf.addPage(pw.Page(
      build: (context) => pw.Column(
        crossAxisAlignment: pw.CrossAxisAlignment.start,
        children: [
          pw.Row(
            mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
            children: [
              pw.Column(
                crossAxisAlignment: pw.CrossAxisAlignment.start,
                children: [
                  pw.Text(negocio.nombre, style: pw.TextStyle(fontSize: 18, fontWeight: pw.FontBold)),
                  pw.Text("Tel: ${negocio.telefono}", style: const pw.TextStyle(fontSize: 10)),
                  pw.Text(negocio.direccion, style: const pw.TextStyle(fontSize: 10)),
                ],
              ),
              if (logoNegocioImage != null) pw.Container(width: 45, height: 45, child: pw.Image(logoNegocioImage)),
            ],
          ),
          pw.Divider(thickness: 2),
          pw.Text("NOTA DE PEDIDO", style: pw.TextStyle(fontSize: 14, fontWeight: pw.FontBold)),
          pw.Text("Cliente: ${orden.cliente} | Fecha: ${orden.fecha.day}/${orden.fecha.month}/${orden.fecha.year}"),
          pw.SizedBox(height: 10),
          pw.Table.fromTextArray(
            headers: ['Cant.', 'Descripción Prenda', 'P. Unitario', 'Subtotal'],
            data: [
              ['${orden.cantidad}', '${orden.productoNameDetalle()}', '\$${orden.precioBaseUnitario.toStringAsFixed(2)}', '\$${(orden.precioBaseUnitario * orden.cantidad).toStringAsFixed(2)}'],
              ...orden.logotiposExtras.map((l) => ['-', 'Extra: ${l.ubicacion} (${l.descripcion})', '\$${l.costoExtra.toStringAsFixed(2)}', '\$${(l.costoExtra * orden.cantidad).toStringAsFixed(2)}']),
            ],
          ),
          if (orden.costoEnvio > 0) ...[
            pw.SizedBox(height: 5),
            pw.Text("Costo de Envío: \$${orden.costoEnvio.toStringAsFixed(2)}", style: const pw.TextStyle(fontSize: 10)),
          ],
          pw.Spacer(),
          pw.Divider(),
          pw.Row(mainAxisAlignment: pw.MainAxisAlignment.spaceBetween, children: [pw.Text("Total de la Orden:"), pw.Text("\$${orden.total.toStringAsFixed(2)}")]),
          pw.Row(mainAxisAlignment: pw.MainAxisAlignment.spaceBetween, children: [pw.Text("Anticipo Recibido:"), pw.Text("\$${orden.anticipo.toStringAsFixed(2)}")]),
          pw.Row(mainAxisAlignment: pw.MainAxisAlignment.spaceBetween, children: [pw.Text("Restante a Pagar:", style: pw.TextStyle(fontWeight: pw.FontBold)), pw.Text("\$${orden.restante.toStringAsFixed(2)}", style: pw.TextStyle(fontWeight: pw.FontBold, color: PdfColors.red))]),
        ],
      ),
    ));

    // HOJA 2: GUÍA DE PERSONALIZACIÓN Y LOGOS EXTRAS
    pdf.addPage(pw.Page(
      build: (context) => pw.Column(
        crossAxisAlignment: pw.CrossAxisAlignment.start,
        children: [
          pw.Text("GUÍA DE PRODUCCIÓN - LOGOS Y UBICACIONES", style: pw.TextStyle(fontSize: 16, fontWeight: pw.FontBold)),
          pw.Text("Cliente: ${orden.cliente} | Prenda: ${orden.productoNameDetalle()}", style: const pw.TextStyle(fontSize: 10)),
          pw.Divider(),
          pw.SizedBox(height: 10),
          ...orden.logotiposExtras.map((logo) {
            pw.ImageProvider? imgLogo;
            if (logo.imagenPath != null && File(logo.imagenPath!).existsSync()) {
              imgLogo = pw.MemoryImage(File(logo.imagenPath!).readAsBytesSync());
            }
            return pw.Container(
              margin: const pw.EdgeInsets.only(bottom: 15),
              padding: const pw.EdgeInsets.all(8),
              decoration: pw.BoxDecoration(border: pw.Border.all(color: PdfColors.grey), borderRadius: const pw.BorderRadius.all(pw.Radius.circular(5))),
              child: pw.Row(
                crossAxisAlignment: pw.CrossAxisAlignment.start,
                children: [
                  if (imgLogo != null) ...[
                    pw.Container(width: 60, height: 60, child: pw.Image(imgLogo)),
                    pw.SizedBox(width: 15),
                  ],
                  pw.Column(
                    crossAxisAlignment: pw.CrossAxisAlignment.start,
                    children: [
                      pw.Text("Ubicación: ${logo.ubicacion.toUpperCase()}", style: pw.TextStyle(fontWeight: pw.FontBold, fontSize: 12, color: PdfColors.blue800)),
                      pw.Text("Detalle: ${logo.descripcion}", style: const pw.TextStyle(fontSize: 10)),
                    ],
                  ),
                ],
              ),
            );
          }),
        ],
      ),
    ));

    final output = await getTemporaryDirectory();
    final file = File("${output.path}/orden_${orden.cliente}.pdf");
    await file.writeAsBytes(await pdf.save());
    await Share.shareXFiles([XFile(file.path)], text: 'Nota y Guía de Producción - ${orden.cliente}');
  }
}

extension OrdenExt on OrdenTrabajo {
  String productoNameDetalle() => '$productoNombre (${colorSeleccionado}, Talla $tallaSeleccionada)';
}

// --- VISTA 2: PIEZAS PENDIENTES DE SURTIR ---
class VistaPendientesSurtir extends StatelessWidget {
  final List<OrdenTrabajo> ordenes;
  final VoidCallback onActualizar;

  const VistaPendientesSurtir({super.key, required this.ordenes, required this.onActualizar});

  @override
  Widget build(BuildContext context) {
    return ordenes.isEmpty
        ? const Center(child: Text('¡Excelente! No hay piezas pendientes de surtir.'))
        : ListView.builder(
            itemCount: ordenes.length,
            itemBuilder: (context, index) {
              final orden = ordenes[index];
              return Card(
                color: Colors.orange[50],
                margin: const EdgeInsets.all(8.0),
                child: ListTile(
                  title: Text('Cliente: ${orden.cliente}', style: const TextStyle(fontWeight: FontWeight.bold)),
                  subtitle: Text('Faltan ${orden.cantidad} piezas de: ${orden.productoNameDetalle()}\nFecha del pedido: ${orden.fecha.day}/${orden.fecha.month}/${orden.fecha.year}'),
                  isThreeLine: true,
                  trailing: ElevatedButton(
                    onPressed: () {
                      orden.estatusInventario = 'Surtido';
                      orden.estatusProduccion = 'En Producción';
                      onActualizar();
                    },
                    child: const Text('Marcar Surtido'),
                  ),
                ),
              );
            },
          );
  }
}

// --- VISTA 3: HISTORIAL DE PEDIDOS FINALIZADOS ---
class VistaHistorialMes extends StatefulWidget {
  final List<OrdenTrabajo> ordenes;
  const VistaHistorialMes({super.key, required this.ordenes});

  @override
  State<VistaHistorialMes> createState() => _VistaHistorialMesState();
}

class _VistaHistorialMesState extends State<VistaHistorialMes> {
  int _mesSeleccionado = DateTime.now().month;
  int _anioSeleccionado = DateTime.now().year;

  final List<String> _meses = [
    'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
  ];

  @override
  Widget build(BuildContext context) {
    final ordenesFiltradas = widget.ordenes.where((o) => o.fecha.month == _mesSeleccionado && o.fecha.year == _anioSeleccionado).toList();

    return Column(
      children: [
        Padding(
          padding: const EdgeInsets.all(8.0),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              const Text('Seleccionar Mes: '),
              DropdownButton<int>(
                value: _mesSeleccionado,
                items: List.generate(12, (index) => DropdownMenuItem(value: index + 1, child: Text(_meses[index]))),
                onChanged: (val) => setState(() => _mesSeleccionado = val!),
              ),
            ],
          ),
        ),
        Expanded(
          child: ordenesFiltradas.isEmpty
              ? const Center(child: Text('No hay pedidos finalizados en este mes.'))
              : ListView.builder(
                  itemCount: ordenesFiltradas.length,
                  itemBuilder: (context, index) {
                    final o = ordenesFiltradas[index];
                    return ListTile(
                      title: Text(o.cliente),
                      subtitle: Text('${o.productoNameDetalle()} - ${o.fecha.day}/${o.fecha.month}/${o.fecha.year}'),
                      trailing: Text('\$${o.total.toStringAsFixed(2)}', style: const TextStyle(fontWeight: FontWeight.bold)),
                    );
                  },
                ),
        ),
      ],
    );
  }
}

// --- VISTA 4: INVENTARIO Y STOCK ---
class VistaInventario extends StatelessWidget {
  final List<ProductoBase> inventario;
  final VoidCallback onActualizar;
  
  const VistaInventario({super.key, required this.inventario, required this.onActualizar});

  @override
  Widget build(BuildContext context) {
    return ListView.builder(
      itemCount: inventario.length,
      itemBuilder: (context, index) {
        final p = inventario[index];
        return Card(
          margin: const EdgeInsets.all(8.0),
          child: ListTile(
            title: Text(p.nombre, style: const TextStyle(fontWeight: FontWeight.bold)),
            subtitle: Text('Precio Base: \$${p.precioBase.toStringAsFixed(2)}\nColores: ${p.coloresDisponibles.join(", ")}'),
            isThreeLine: true,
            trailing: Chip(
              label: Text('Stock: ${p.stockGeneral}'),
              backgroundColor: p.stockGeneral < 3 ? Colors.red[100] : Colors.green[100],
            ),
          ),
        );
      },
    );
  }
}