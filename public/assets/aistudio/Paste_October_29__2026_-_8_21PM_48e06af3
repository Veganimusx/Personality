// --- VISTA 3: HISTORIAL DE PEDIDOS FINALIZADOS ---
class VistaHistorialMes extends StatefulWidget {
  final List<OrdenTrabajo> ordenes;
  const VistaHistorialMes({super.key, required this.ordenes});

  @override
  State<VistaHistorialMes> createState() => _VistaHistorialMesState();
}

class _VistaHistorialMesState extends State<VistaHistorialMes> {
  int _mesSeleccionado = DateTime.now().month;
  int _anioSeleccionado = DateTime.now().year;

  final List<String> _meses = [
    'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
  ];

  @override
  Widget build(BuildContext context) {
    final ordenesFiltradas = widget.ordenes.where((o) => o.fecha.month == _mesSeleccionado && o.fecha.year == _anioSeleccionado).toList();

    return Column(
      children: [
        Padding(
          padding: const EdgeInsets.all(8.0),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              const Text('Seleccionar Mes: '),
              DropdownButton<int>(
                value: _mesSeleccionado,
                items: List.generate(12, (index) => DropdownMenuItem(value: index + 1, child: Text(_meses[index]))),
                onChanged: (val) => setState(() => _mesSeleccionado = val!),
              ),
            ],
          ),
        ),
        Expanded(
          child: ordenesFiltradas.isEmpty
              ? const Center(child: Text('No hay pedidos finalizados en este mes.'))
              : ListView.builder(
                  itemCount: ordenesFiltradas.length,
                  itemBuilder: (context, index) {
                    final o = ordenesFiltradas[index];
                    return ListTile(
                      title: Text(o.cliente),
                      subtitle: Text('Total de artículos: ${o.items.length} - ${o.fecha.day}/${o.fecha.month}/${o.fecha.year}'),
                      trailing: Text('\$${o.total.toStringAsFixed(2)}', style: const TextStyle(fontWeight: FontWeight.bold)),
                    );
                  },
                ),
        ),
      ],
    );
  }
}

