// Modelos de Datos
class DatosNegocio {
  String nombre;
  String telefono;
  String direccion;
  String? logoPath;

  DatosNegocio({required this.nombre, required this.telefono, required this.direccion, this.logoPath});
}

class ProductoBase {
  String nombre;
  double precioBase;
  List<String> coloresDisponibles;
  List<String> tallasDisponibles;
  int stockGeneral;

  ProductoBase({
    required this.nombre,
    required this.precioBase,
    required this.coloresDisponibles,
    required this.tallasDisponibles,
    required this.stockGeneral,
  });
}

class UbicacionLogoExtra {
  String ubicacion; 
  String descripcion; 
  double costoExtra;
  String? imagenPath;

  UbicacionLogoExtra({required this.ubicacion, required this.descripcion, required this.costoExtra, this.imagenPath});
}

class ItemOrden {
  String productoNombre;
  String color;
  String talla;
  int cantidad;
  double precioUnitarioFinal; // Ya incluye base + extras sumados
  List<UbicacionLogoExtra> logotiposExtras;

  ItemOrden({
    required this.productoNombre,
    required this.color,
    required this.talla,
    required this.cantidad,
    required this.precioUnitarioFinal,
    required this.logotiposExtras,
  });

  double get subtotal => precioUnitarioFinal * cantidad;
}

class OrdenTrabajo {
  String id;
  String cliente;
  String telefono;
  List<ItemOrden> items; // Múltiples artículos por orden
  double costoEnvio;
  double anticipo;
  String estatusProduccion; 
  String estatusInventario; 
  DateTime fecha;

  OrdenTrabajo({
    required this.id,
    required this.cliente,
    required this.telefono,
    required this.items,
    required this.costoEnvio,
    required this.anticipo,
    required this.estatusProduccion,
    required this.estatusInventario,
    required this.fecha,
  });

  double get totalItems => items.fold(0.0, (sum, item) => sum + item.subtotal);
  double get total => totalItems + costoEnvio;
  double get restante => total - anticipo;
}

class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  int _selectedIndex = 0;

  DatosNegocio _negocio = DatosNegocio(
    nombre: 'UNITAP - Bordados y Uniformes',
    telefono: '81 0000 0000',
    direccion: 'Guadalupe, Nuevo León',
  );

  final List<ProductoBase> _inventario = [
    ProductoBase(
      nombre: 'Polo Piqué Dry-Fit',
      precioBase: 180.0,
      coloresDisponibles: ['Azul Marino', 'Negro', 'Blanco', 'Rojo'],
      tallasDisponibles: ['S', 'M', 'L', 'XL', 'XXL'],
      stockGeneral: 15,
    ),
    ProductoBase(
      nombre: 'Playera Cuello Redondo Algodón',
      precioBase: 120.0,
      coloresDisponibles: ['Gris', 'Negro', 'Azul Rey'],
      tallasDisponibles: ['M', 'L', 'XL'],
      stockGeneral: 5,
    ),
  ];

  final List<OrdenTrabajo> _ordenes = [];

  void _guardarOrden(OrdenTrabajo orden, {bool esEdicion = false}) {
    setState(() {
      for (var item in orden.items) {
        // Buscar el producto en inventario para descontar stock
        var prodBase = _inventario.firstWhere(
          (p) => p.nombre == item.productoNombre,
          orElse: () => _inventario.first,
        );
        if (prodBase.stockGeneral >= item.cantidad) {
          prodBase.stockGeneral -= item.cantidad;
          orden.estatusInventario = 'Surtido';
        } else {
          orden.estatusInventario = 'Pendiente de surtir';
          orden.estatusProduccion = 'Pendiente de Surtir';
        }
      }
      if (!esEdicion) {
        _ordenes.add(orden);
      }
    });
  }

  void _editarDatosNegocio(BuildContext context) {
    final nombreController = TextEditingController(text: _negocio.nombre);
    final telController = TextEditingController(text: _negocio.telefono);
    final dirController = TextEditingController(text: _negocio.direccion);
    String? tempLogo = _negocio.logoPath;

    showDialog(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setStateDialog) {
            return AlertDialog(
              title: const Text('Configurar Datos del Negocio'),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    TextField(controller: nombreController, decoration: const InputDecoration(labelText: 'Nombre del Negocio')),
                    TextField(controller: telController, decoration: const InputDecoration(labelText: 'Teléfono')),
                    TextField(controller: dirController, decoration: const InputDecoration(labelText: 'Ubicación / Dirección')),
                    const SizedBox(height: 10),
                    ElevatedButton.icon(
                      onPressed: () async {
                        final picker = ImagePicker();
                        final image = await picker.pickImage(source: ImageSource.gallery);
                        if (image != null) {
                          setStateDialog(() => tempLogo = image.path);
                        }
                      },
                      icon: const Icon(Icons.image),
                      label: Text(tempLogo == null ? 'Subir Logotipo' : 'Logo Seleccionado'),
                    ),
                  ],
                ),
              ),
              actions: [
                TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancelar')),
                ElevatedButton(
                  onPressed: () {
                    setState(() {
                      _negocio = DatosNegocio(
                        nombre: nombreController.text,
                        telefono: telController.text,
                        direccion: dirController.text,
                        logoPath: tempLogo,
                      );
                    });
                    Navigator.pop(context);
                  },
                  child: const Text('Guardar'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    final List<Widget> pantallas = [
      VistaOrdenesActivas(
        ordenes: _ordenes.where((o) => o.estatusProduccion != 'Entregado').toList(),
        inventario: _inventario,
        datosNegocio: _negocio,
        onGuardarOrden: _guardarOrden,
        onActualizar: () => setState(() {}),
      ),
      VistaPendientesSurtir(
        ordenes: _ordenes.where((o) => o.estatusInventario == 'Pendiente de surtir').toList(),
        onActualizar: () => setState(() {}),
      ),
      VistaHistorialMes(
        ordenes: _ordenes.where((o) => o.estatusProduccion == 'Entregado').toList(),
      ),
      VistaInventario(
        inventario: _inventario, 
        onActualizar: () => setState(() {}),
      ),
    ];

    return Scaffold(
      appBar: AppBar(
        title: Text(_negocio.nombre, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 18)),
        backgroundColor: Theme.of(context).colorScheme.inversePrimary,
        actions: [
          IconButton(
            icon: const Icon(Icons.settings),
            onPressed: () => _editarDatosNegocio(context),
            tooltip: 'Configurar Negocio y Logo',
          )
        ],
      ),
      body: pantallas[_selectedIndex],
      bottomNavigationBar: NavigationBar(
        selectedIndex: _selectedIndex,
        onDestinationSelected: (index) => setState(() => _selectedIndex = index),
        destinations: const [
          NavigationDestination(icon: Icon(Icons.assignment), label: 'Activas'),
          NavigationDestination(icon: Icon(Icons.shopping_cart_checkout, color: Colors.orange), label: 'Por Surtir'),
          NavigationDestination(icon: Icon(Icons.history), label: 'Finalizados'),
          NavigationDestination(icon: Icon(Icons.inventory), label: 'Stock'),
        ],
      ),
    );
  }
}

// --- VISTA 1: ÓRDENES ACTIVAS ---
class VistaOrdenesActivas extends StatelessWidget {
  final List<OrdenTrabajo> ordenes;
  final List<ProductoBase> inventario;
  final DatosNegocio datosNegocio;
  final Function(OrdenTrabajo, {bool esEdicion}) onGuardarOrden;
  final VoidCallback onActualizar;

  const VistaOrdenesActivas({
    super.key,
    required this.ordenes,
    required this.inventario,
    required this.datosNegocio,
    required this.onGuardarOrden,
    required this.onActualizar,
  });

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: ordenes.isEmpty
          ? const Center(child: Text('No hay órdenes activas. Presiona + para crear una.'))
          : ListView.builder(
              itemCount: ordenes.length,
              itemBuilder: (context, index) {
                final orden = ordenes[index];
                return Card(
                  margin: const EdgeInsets.all(8.0),
                  child: Padding(
                    padding: const EdgeInsets.all(12.0),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          mainAxisAlignment: MainAxisAlignment.spaceBetween,
                          children: [
                            Text(orden.cliente, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
                            Chip(
                              label: Text(orden.estatusProduccion, style: const TextStyle(fontSize: 12)),
                              backgroundColor: orden.estatusProduccion == 'Pendiente de Surtir' ? Colors.orange[100] : Colors.blue[100],
                            ),
                          ],
                        ),
                        const SizedBox(height: 5),
                        ...orden.items.map((item) => Text('• ${item.cantidad}x ${item.productoNameDetalle()} - P. Unit: \$${item.precioUnitarioFinal.toStringAsFixed(2)}')),
                        if (orden.costoEnvio > 0) Text('• Envío: \$${orden.costoEnvio.toStringAsFixed(2)}', style: const TextStyle(fontSize: 12)),
                        Text('Inventario: ${orden.estatusInventario}', style: TextStyle(color: orden.estatusInventario == 'Pendiente de surtir' ? Colors.red : Colors.green, fontWeight: FontWeight.bold)),
                        const Divider(),
                        Row(
                          mainAxisAlignment: MainAxisAlignment.spaceBetween,
                          children: [
                            Text('Total: \$${orden.total.toStringAsFixed(2)}'),
                            Text('Anticipo: \$${orden.anticipo.toStringAsFixed(2)}'),
                            Text('Restante: \$${orden.restante.toStringAsFixed(2)}', style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.red)),
                          ],
                        ),
                        const SizedBox(height: 10),
                        Wrap(
                          spacing: 8,
                          children: [
                            ElevatedButton.icon(
                              onPressed: () {
                                if (orden.estatusProduccion == 'Pendiente de Surtir') {
                                  orden.estatusProduccion = 'En Producción';
                                  orden.estatusInventario = 'Surtido';
                                } else if (orden.estatusProduccion == 'En Producción') {
                                  orden.estatusProduccion = 'Listo';
                                } else if (orden.estatusProduccion == 'Listo') {
                                  orden.estatusProduccion = 'Entregado';
                                }
                                onActualizar();
                              },
                              icon: const Icon(Icons.update, size: 16),
                              label: Text(orden.estatusProduccion == 'Pendiente de Surtir' ? 'Marcar Surtido' : 'Avanzar Estatus'),
                            ),
                            IconButton(
                              icon: const Icon(Icons.edit, color: Colors.blue),
                              onPressed: () => _mostrarFormularioOrden(context, ordenExistente: orden),
                              tooltip: 'Editar Orden',
                            ),
                            IconButton(
                              icon: const Icon(Icons.chat, color: Colors.green),
                              onPressed: () => _enviarWhatsApp(orden),
                              tooltip: 'Enviar WhatsApp',
                            ),
                            IconButton(
                              icon: const Icon(Icons.picture_as_pdf, color: Colors.red),
                              onPressed: () => _generarYCompartirPDF(orden, datosNegocio),
                              tooltip: 'Compartir PDF',
                            ),
                          ],
                        )
                      ],
                    ),
                  ),
                );
              },
            ),
      floatingActionButton: FloatingActionButton(
        onPressed: () => _mostrarFormularioOrden(context),
        child: const Icon(Icons.add),
      ),
    );
  }

  // --- FORMULARIO MULTI-ARTÍCULOS Y EDICIÓN ---
  void _mostrarFormularioOrden(BuildContext context, {OrdenTrabajo? ordenExistente}) {
    final clienteController = TextEditingController(text: ordenExistente?.cliente ?? '');
    final telefonoController = TextEditingController(text: ordenExistente?.telefono ?? '');
    final envioController = TextEditingController(text: ordenExistente?.costoEnvio.toString() ?? '0');
    final anticipoController = TextEditingController(text: ordenExistente?.anticipo.toString() ?? '');

    List<ItemOrden> listaItems = List.from(ordenExistente?.items ?? []);

    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      builder: (context) {
        return Padding(
          padding: EdgeInsets.only(bottom: MediaQuery.of(context).viewInsets.bottom, left: 16, right: 16, top: 16),
          child: StatefulBuilder(
            builder: (context, setStateModal) {
              return SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(ordenExistente == null ? 'Nueva Orden de Trabajo' : 'Editar Orden de Trabajo', style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
                    TextField(controller: clienteController, decoration: const InputDecoration(labelText: 'Nombre del Cliente')),
                    TextField(controller: telefonoController, decoration: const InputDecoration(labelText: 'Teléfono (WhatsApp)'), keyboardType: TextInputType.phone),
                    
                    const Divider(height: 30),
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        const Text('Artículos en la Orden', style: TextStyle(fontWeight: FontWeight.bold, fontSize: 15)),
                        ElevatedButton.icon(
                          onPressed: () => _mostrarDialogoAgregarItem(context, setStateModal, listaItems),
                          icon: const Icon(Icons.add, size: 16),
                          label: const Text('Añadir Artículo'),
                        ),
                      ],
                    ),

                    if (listaItems.isEmpty)
                      const Padding(
                        padding: EdgeInsets.all(8.0),
                        child: Text('No hay artículos agregados todavía.', style: TextStyle(color: Colors.grey)),
                      ),

                    ...listaItems.asMap().entries.map((entry) {
                      int idx = entry.key;
                      var item = entry.value;
                      return Card(
                        margin: const EdgeInsets.symmetric(vertical: 4),
                        child: ListTile(
                          title: Text('${item.cantidad}x ${item.productoNameDetalle()}'),
                          subtitle: Text('Precio Final Unitario: \$${item.precioUnitarioFinal.toStringAsFixed(2)} | Subtotal: \$${item.subtotal.toStringAsFixed(2)}'),
                          trailing: IconButton(
                            icon: const Icon(Icons.delete, color: Colors.red),
                            onPressed: () => setStateModal(() => listaItems.removeAt(idx)),
                          ),
                        ),
                      );
                    }),

                    const Divider(height: 30),
                    TextField(controller: envioController, decoration: const InputDecoration(labelText: 'Costo de Envío \$ (Opcional)'), keyboardType: TextInputType.number),
                    TextField(controller: anticipoController, decoration: const InputDecoration(labelText: 'Anticipo Recibido \$'), keyboardType: TextInputType.number),

                    const SizedBox(height: 20),
                    ElevatedButton(
                      onPressed: () {
                        if (clienteController.text.isEmpty || listaItems.isEmpty) return;

                        double envio = double.tryParse(envioController.text) ?? 0.0;
                        double ant = double.tryParse(anticipoController.text) ?? 0.0;

                        if (ordenExistente == null) {
                          OrdenTrabajo nueva = OrdenTrabajo(
                            id: DateTime.now().millisecondsSinceEpoch.toString(),
                            cliente: clienteController.text,
                            telefono: telefonoController.text,
                            items: listaItems,
                            costoEnvio: envio,
                            anticipo: ant,
                            estatusProduccion: 'En Producción',
                            estatusInventario: 'Surtido',
                            fecha: DateTime.now(),
                          );
                          onGuardarOrden(nueva);
                        } else {
                          ordenExistente.cliente = clienteController.text;
                          ordenExistente.telefono = telefonoController.text;
                          ordenExistente.items = listaItems;
                          ordenExistente.costoEnvio = envio;
                          ordenExistente.anticipo = ant;
                          onGuardarOrden(ordenExistente, esEdicion: true);
                        }

                        Navigator.pop(context);
                        onActualizar();
                      },
                      style: ElevatedButton.styleFrom(minimumSize: const Size.fromHeight(45)),
                      child: Text(ordenExistente == null ? 'Guardar Orden' : 'Actualizar Orden'),
                    ),
                    const SizedBox(height: 20),
                  ],
                ),
              );
            },
          ),
        );
      },
    );
  }

  // --- DIÁLOGO CORREGIDO PARA AGREGAR ARTÍCULO CON LOGOS EXTRAS ---
  void _mostrarDialogoAgregarItem(BuildContext parentContext, StateSetter setStateModalPrincipal, List<ItemOrden> listaItems) {
    ProductoBase? productoSeleccionado;
    String colorSeleccionado = '';
    String tallaSeleccionada = '';
    final cantidadController = TextEditingController(text: '1');
    final precioBaseController = TextEditingController();
    List<UbicacionLogoExtra> listaLogosItem = [];

    showDialog(
      context: parentContext,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setStateDialog) {
            return AlertDialog(
              title: const Text('Agregar Artículo'),
              content: SizedBox(
                width: MediaQuery.of(parentContext).size.width * 0.8,
                child: SingleChildScrollView(
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      DropdownButtonFormField<ProductoBase>(
                        isExpanded: true,
                        hint: const Text('Modelo de Prenda'),
                        items: inventario.map((p) => DropdownMenuItem(value: p, child: Text('${p.nombre} (\$${p.precioBase})'))).toList(),
                        onChanged: (val) {
                          setStateDialog(() {
                            productoSeleccionado = val;
                            if (val != null) {
                              if (val.coloresDisponibles.isNotEmpty) colorSeleccionado = val.coloresDisponibles.first;
                              if (val.tallasDisponibles.isNotEmpty) tallaSeleccionada = val.tallasDisponibles.first;
                              precioBaseController.text = val.precioBase.toString();
                            }
                          });
                        },
                      ),
                      if (productoSeleccionado != null) ...[
                        const SizedBox(height: 10),
                        Row(
                          children: [
                            Expanded(
                              child: DropdownButtonFormField<String>(
                                isExpanded: true,
                                value: colorSeleccionado.isEmpty ? null : colorSeleccionado,
                                hint: const Text('Color'),
                                items: productoSeleccionado!.coloresDisponibles.map((c) => DropdownMenuItem(value: c, child: Text(c))).toList(),
                                onChanged: (val) => setStateDialog(() => colorSeleccionado = val!),
                              ),
                            ),
                            const SizedBox(width: 10),
                            Expanded(
                              child: DropdownButtonFormField<String>(
                                isExpanded: true,
                                value: tallaSeleccionada.isEmpty ? null : tallaSeleccionada,
                                hint: const Text('Talla'),
                                items: productoSeleccionado!.tallasDisponibles.map((t) => DropdownMenuItem(value: t, child: Text(t))).toList(),
                                onChanged: (val) => setStateDialog(() => tallaSeleccionada = val!),
                              ),
                            ),
                          ],
                        ),
                      ],
                      const SizedBox(height: 10),
                      TextField(controller: cantidadController, decoration: const InputDecoration(labelText: 'Cantidad'), keyboardType: TextInputType.number),
                      TextField(controller: precioBaseController, decoration: const InputDecoration(labelText: 'Precio Base Unitario \$'), keyboardType: TextInputType.number),
                      
                      const Divider(height: 20),
                      Row(
                        mainAxisAlignment: MainAxisAlignment.spaceBetween,
                        children: [
                          const Text('Logos / Nombres Extras', style: TextStyle(fontWeight: FontWeight.bold, fontSize: 13)),
                          TextButton.icon(
                            onPressed: () => _mostrarDialogoLogoExtra(parentContext, setStateDialog, listaLogosItem),
                            icon: const Icon(Icons.add, size: 14),
                            label: const Text('Añadir Logo'),
                          )
                        ],
                      ),
                      ...listaLogosItem.asMap().entries.map((entry) {
                        int idx = entry.key;
                        var logo = entry.value;
                        return ListTile(
                          dense: true,
                          title: Text('${logo.ubicacion}: ${logo.descripcion}'),
                          subtitle: Text('Suma al precio unitario: +\$${logo.costoExtra.toStringAsFixed(2)}'),
                          trailing: IconButton(
                            icon: const Icon(Icons.delete, color: Colors.red, size: 18),
                            onPressed: () => setStateDialog(() => listaLogosItem.removeAt(idx)),
                          ),
                        );
                      }),
                    ],
                  ),
                ),
              ),
              actions: [
                TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancelar')),
                ElevatedButton(
                  onPressed: () {
                    if (productoSeleccionado == null) return;
                    double base = double.tryParse(precioBaseController.text) ?? 0.0;
                    int cant = int.tryParse(cantidadController.text) ?? 1;
                    
                    // Sumamos costos extra directamente al precio unitario final de la playera
                    double extrasTotales = listaLogosItem.fold(0.0, (sum, l) => sum + l.costoExtra);
                    double precioUnitarioFinalUnificado = base + extrasTotales;

                    setStateModalPrincipal(() {
                      listaItems.add(ItemOrden(
                        productoNombre: productoSeleccionado!.nombre,
                        color: colorSeleccionado,
                        talla: tallaSeleccionada,
                        cantidad: cant,
                        precioUnitarioFinal: precioUnitarioFinalUnificado,
                        logotiposExtras: listaLogosItem,
                      ));
                    });
                    Navigator.pop(context);
                  },
                  child: const Text('Agregar a la Orden'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  // --- SUB-DIÁLOGO PERFECTAMENTE CENTRADO PARA LOGOS EXTRAS ---
  void _mostrarDialogoLogoExtra(BuildContext parentContext, StateSetter setStateDialogPadre, List<UbicacionLogoExtra> listaLogosItem) {
    String ubicacion = 'Pecho Izquierdo';
    final descController = TextEditingController();
    final costoController = TextEditingController();
    String? imgPath;

    showDialog(
      context: parentContext,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setStateDialogSub) {
            return AlertDialog(
              title: const Text('Detalle de Logo o Nombre Extra'),
              content: SizedBox(
                width: MediaQuery.of(parentContext).size.width * 0.7,
                child: SingleChildScrollView(
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      DropdownButtonFormField<String>(
                        isExpanded: true,
                        value: ubicacion,
                        items: ['Pecho Izquierdo', 'Pecho Derecho', 'Espalda', 'Manga Izquierda', 'Manga Derecha', 'Nombre Personalizado'].map((u) => DropdownMenuItem(value: u, child: Text(u))).toList(),
                        onChanged: (val) => setStateDialogSub(() => ubicacion = val!),
                      ),
                      TextField(controller: descController, decoration: const InputDecoration(labelText: 'Descripción (ej. Logo bordado dorado)')),
                      TextField(controller: costoController, decoration: const InputDecoration(labelText: 'Costo a sumar al precio unitario \$'), keyboardType: TextInputType.number),
                      const SizedBox(height: 10),
                      ElevatedButton.icon(
                        onPressed: () async {
                          final picker = ImagePicker();
                          final image = await picker.pickImage(source: ImageSource.gallery);
                          if (image != null) {
                            setStateDialogSub(() => imgPath = image.path);
                          }
                        },
                        icon: const Icon(Icons.camera_alt),
                        label: Text(imgPath == null ? 'Adjuntar Imagen' : 'Imagen Adjunta ✓'),
                      ),
                    ],
                  ),
                ),
              ),
              actions: [
                TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancelar')),
                ElevatedButton(
                  onPressed: () {
                    double costo = double.tryParse(costoController.text) ?? 0.0;
                    setStateDialogPadre(() {
                      listaLogosItem.add(UbicacionLogoExtra(
                        ubicacion: ubicacion,
                        descripcion: descController.text.isEmpty ? ubicacion : descController.text,
                        costoExtra: costo,
                        imagenPath: imgPath,
                      ));
                    });
                    Navigator.pop(context);
                  },
                  child: const Text('Añadir'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  Future<void> _enviarWhatsApp(OrdenTrabajo orden) async {
    String itemsTexto = orden.items.map((i) => '• ${i.cantidad}x ${i.productoNameDetalle()} - \$${i.precioUnitarioFinal.toStringAsFixed(2)} c/u').join('\n');
    final String mensaje = '''
*UNITAP - Resumen de Pedido*
Hola *${orden.cliente}*, este es el detalle de tu orden:
$itemsTexto
${orden.costoEnvio > 0 ? '• Envío: \$${orden.costoEnvio.toStringAsFixed(2)}\n' : ''}• Total: \$${orden.total.toStringAsFixed(2)}
• Anticipo: \$${orden.anticipo.toStringAsFixed(2)}
• Restante: \$${orden.restante.toStringAsFixed(2)}
''';
    final Uri url = Uri.parse('https://wa.me/${orden.telefono.replaceAll(RegExp(r'\D'), '')}?text=${Uri.encodeComponent(mensaje)}');
    if (await canLaunchUrl(url)) await launchUrl(url, mode: LaunchMode.externalApplication);
  }

  Future<void> _generarYCompartirPDF(OrdenTrabajo orden, DatosNegocio negocio) async {
    final pdf = pw.Document();

    pw.ImageProvider? logoNegocioImage;
    if (negocio.logoPath != null && File(negocio.logoPath!).existsSync()) {
      logoNegocioImage = pw.MemoryImage(File(negocio.logoPath!).readAsBytesSync());
    }

    // HOJA 1: NOTA DE PEDIDO Y PRECIOS UNIFICADOS
    pdf.addPage(pw.Page(
      build: (context) => pw.Column(
        crossAxisAlignment: pw.CrossAxisAlignment.start,
        children: [
          pw.Row(
            mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
            children: [
              pw.Column(
                crossAxisAlignment: pw.CrossAxisAlignment.start,
                children: [
                  pw.Text(negocio.nombre, style: pw.TextStyle(fontSize: 18, fontWeight: pw.FontBold)),
                  pw.Text("Tel: ${negocio.telefono}", style: const pw.TextStyle(fontSize: 10)),
                  pw.Text(negocio.direccion, style: const pw.TextStyle(fontSize: 10)),
                ],
              ),
              if (logoNegocioImage != null) pw.Container(width: 45, height: 45, child: pw.Image(logoNegocioImage)),
            ],
          ),
          pw.Divider(thickness: 2),
          pw.Text("NOTA DE PEDIDO", style: pw.TextStyle(fontSize: 14, fontWeight: pw.FontBold)),
          pw.Text("Cliente: ${orden.cliente} | Fecha: ${orden.fecha.day}/${orden.fecha.month}/${orden.fecha.year}"),
          pw.SizedBox(height: 10),
          pw.Table.fromTextArray(
            headers: ['Cant.', 'Descripción Prenda', 'P. Unitario Final', 'Subtotal'],
            data: orden.items.map((i) => [
              '${i.cantidad}',
              i.productoNameDetalle(),
              '\$${i.precioUnitarioFinal.toStringAsFixed(2)}',
              '\$${i.subtotal.toStringAsFixed(2)}'
            ]).toList(),
          ),
          if (orden.costoEnvio > 0) ...[
            pw.SizedBox(height: 5),
            pw.Text("Costo de Envío: \$${orden.costoEnvio.toStringAsFixed(2)}", style: const pw.TextStyle(fontSize: 10)),
          ],
          pw.Spacer(),
          pw.Divider(),
          pw.Row(mainAxisAlignment: pw.MainAxisAlignment.spaceBetween, children: [pw.Text("Total de la Orden:"), pw.Text("\$${orden.total.toStringAsFixed(2)}")]),
          pw.Row(mainAxisAlignment: pw.MainAxisAlignment.spaceBetween, children: [pw.Text("Anticipo Recibido:"), pw.Text("\$${orden.anticipo.toStringAsFixed(2)}")]),
          pw.Row(mainAxisAlignment: pw.MainAxisAlignment.spaceBetween, children: [pw.Text("Restante a Pagar:", style: pw.TextStyle(fontWeight: pw.FontBold)), pw.Text("\$${orden.restante.toStringAsFixed(2)}", style: pw.TextStyle(fontWeight: pw.FontBold, color: PdfColors.red))]),
        ],
      ),
    ));

    // HOJA 2: GUÍA DE PRODUCCIÓN
    pdf.addPage(pw.Page(
      build: (context) => pw.Column(
        crossAxisAlignment: pw.CrossAxisAlignment.start,
        children: [
          pw.Text("GUÍA DE PRODUCCIÓN - LOGOS Y UBICACIONES", style: pw.TextStyle(fontSize: 16, fontWeight: pw.FontBold)),
          pw.Text("Cliente: ${orden.cliente}", style: const pw.TextStyle(fontSize: 10)),
          pw.Divider(),
          pw.SizedBox(height: 10),
          ...orden.items.expand((item) => item.logotiposExtras.map((logo) {
            pw.ImageProvider? imgLogo;
            if (logo.imagenPath != null && File(logo.imagenPath!).existsSync()) {
              imgLogo = pw.MemoryImage(File(logo.imagenPath!).readAsBytesSync());
            }
            return pw.Container(
              margin: const pw.EdgeInsets.only(bottom: 10),
              padding: const pw.EdgeInsets.all(6),
              decoration: pw.BoxDecoration(border: pw.Border.all(color: PdfColors.grey), borderRadius: const pw.BorderRadius.all(pw.Radius.circular(5))),
              child: pw.Row(
                crossAxisAlignment: pw.CrossAxisAlignment.start,
                children: [
                  if (imgLogo != null) ...[
                    pw.Container(width: 50, height: 50, child: pw.Image(imgLogo)),
                    pw.SizedBox(width: 10),
                  ],
                  pw.Column(
                    crossAxisAlignment: pw.CrossAxisAlignment.start,
                    children: [
                      pw.Text("Prenda: ${item.productoNameDetalle()}", style: const pw.TextStyle(fontSize: 9, color: PdfColors.grey700)),
                      pw.Text("Ubicación: ${logo.ubicacion.toUpperCase()}", style: pw.TextStyle(fontWeight: pw.FontBold, fontSize: 11, color: PdfColors.blue800)),
                      pw.Text("Detalle: ${logo.descripcion}", style: const pw.TextStyle(fontSize: 9)),
                    ],
                  ),
                ],
              ),
            );
          })),
        ],
      ),
    ));

    final output = await getTemporaryDirectory();
    final file = File("${output.path}/orden_${orden.cliente}.pdf");
    await file.writeAsBytes(await pdf.save());
    await Share.shareXFiles([XFile(file.path)], text: 'Nota y Guía de Producción - ${orden.cliente}');
  }
}

extension ItemExt on ItemOrden {
  String productoNameDetalle() => '$productoNombre ($color, Talla $talla)';
}

