// Modelos de Datos Actualizados
class DatosNegocio {
  String nombre;
  String telefono;
  String direccion;
  String? logoPath;

  DatosNegocio({required this.nombre, required this.telefono, required this.direccion, this.logoPath});
}

class ProductoBase {
  String nombre;
  double precioBase;
  List<String> coloresDisponibles;
  List<String> tallasDisponibles;
  int stockGeneral; // Stock global o aproximado

  ProductoBase({
    required this.nombre,
    required this.precioBase,
    required this.coloresDisponibles,
    required this.tallasDisponibles,
    required this.stockGeneral,
  });
}

class OrdenTrabajo {
  String id;
  String cliente;
  String telefono;
  String productoNombre;
  String colorSeleccionado;
  String tallaSeleccionada;
  int cantidad;
  double total;
  double anticipo;
  String tecnica;
  String ubicacionLogo;
  String? imagenDisenoPath; // Foto del diseño o logo del cliente para esta orden
  String estatusProduccion; 
  String estatusInventario; 
  DateTime fecha;

  OrdenTrabajo({
    required this.id,
    required this.cliente,
    required this.telefono,
    required this.productoNombre,
    required this.colorSeleccionado,
    required this.tallaSeleccionada,
    required this.cantidad,
    required this.total,
    required this.anticipo,
    required this.tecnica,
    required this.ubicacionLogo,
    this.imagenDisenoPath,
    required this.estatusProduccion,
    required this.estatusInventario,
    required this.fecha,
  });

  double get restante => total - anticipo;
}

class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  int _selectedIndex = 0;

  DatosNegocio _negocio = DatosNegocio(
    nombre: 'UNITAP - Bordados y Uniformes',
    telefono: '81 0000 0000',
    direccion: 'Guadalupe, Nuevo León',
  );

  // Inventario agrupado con variaciones de color y tallas manuales
  final List<ProductoBase> _inventario = [
    ProductoBase(
      nombre: 'Polo Piqué Dry-Fit',
      precioBase: 180.0,
      coloresDisponibles: ['Azul Marino', 'Negro', 'Blanco', 'Rojo'],
      tallasDisponibles: ['S', 'M', 'L', 'XL', 'XXL'],
      stockGeneral: 25,
    ),
    ProductoBase(
      nombre: 'Playera Cuello Redondo Algodón',
      precioBase: 120.0,
      coloresDisponibles: ['Gris', 'Negro', 'Azul Rey'],
      tallasDisponibles: ['M', 'L', 'XL'],
      stockGeneral: 5,
    ),
  ];

  final List<OrdenTrabajo> _ordenes = [];

  void _agregarOrden(OrdenTrabajo nuevaOrden, ProductoBase productoBase) {
    setState(() {
      // Permite hacer la orden aun sin stock, validando y pasando a pendiente si es necesario
      if (productoBase.stockGeneral >= nuevaOrden.cantidad) {
        productoBase.stockGeneral -= nuevaOrden.cantidad;
        nuevaOrden.estatusInventario = 'Surtido';
      } else {
        nuevaOrden.estatusInventario = 'Pendiente de surtir';
        nuevaOrden.estatusProduccion = 'Pendiente de Surtir';
      }
      _ordenes.add(nuevaOrden);
    });
  }

  void _editarDatosNegocio(BuildContext context) {
    final nombreController = TextEditingController(text: _negocio.nombre);
    final telController = TextEditingController(text: _negocio.telefono);
    final dirController = TextEditingController(text: _negocio.direccion);
    String? tempLogo = _negocio.logoPath;

    showDialog(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setStateDialog) {
            return AlertDialog(
              title: const Text('Configurar Datos del Negocio'),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    TextField(controller: nombreController, decoration: const InputDecoration(labelText: 'Nombre del Negocio')),
                    TextField(controller: telController, decoration: const InputDecoration(labelText: 'Teléfono')),
                    TextField(controller: dirController, decoration: const InputDecoration(labelText: 'Ubicación / Dirección')),
                    const SizedBox(height: 10),
                    ElevatedButton.icon(
                      onPressed: () async {
                        final picker = ImagePicker();
                        final image = await picker.pickImage(source: ImageSource.gallery);
                        if (image != null) {
                          setStateDialog(() => tempLogo = image.path);
                        }
                      },
                      icon: const Icon(Icons.image),
                      label: Text(tempLogo == null ? 'Subir Logotipo' : 'Logo Seleccionado'),
                    ),
                  ],
                ),
              ),
              actions: [
                TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancelar')),
                ElevatedButton(
                  onPressed: () {
                    setState(() {
                      _negocio = DatosNegocio(
                        nombre: nombreController.text,
                        telefono: telController.text,
                        direccion: dirController.text,
                        logoPath: tempLogo,
                      );
                    });
                    Navigator.pop(context);
                  },
                  child: const Text('Guardar'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    final List<Widget> pantallas = [
      VistaOrdenesActivas(
        ordenes: _ordenes.where((o) => o.estatusProduccion != 'Entregado').toList(),
        inventario: _inventario,
        datosNegocio: _negocio,
        onNuevaOrden: _agregarOrden,
        onActualizar: () => setState(() {}),
      ),
      VistaHistorialMes(
        ordenes: _ordenes.where((o) => o.estatusProduccion == 'Entregado').toList(),
      ),
      VistaInventario(
        inventario: _inventario, 
        onActualizar: () => setState(() {}),
      ),
    ];

    return Scaffold(
      appBar: AppBar(
        title: Text(_negocio.nombre, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 18)),
        backgroundColor: Theme.of(context).colorScheme.inversePrimary,
        actions: [
          IconButton(
            icon: const Icon(Icons.settings),
            onPressed: () => _editarDatosNegocio(context),
            tooltip: 'Configurar Negocio y Logo',
          )
        ],
      ),
      body: pantallas[_selectedIndex],
      bottomNavigationBar: NavigationBar(
        selectedIndex: _selectedIndex,
        onDestinationSelected: (index) => setState(() => _selectedIndex = index),
        destinations: const [
          NavigationDestination(icon: Icon(Icons.assignment), label: 'Activas'),
          NavigationDestination(icon: Icon(Icons.history), label: 'Finalizados'),
          NavigationDestination(icon: Icon(Icons.inventory), label: 'Catálogo Stock'),
        ],
      ),
    );
  }
}

// --- VISTA 1: ÓRDENES ACTIVAS ---
class VistaOrdenesActivas extends StatelessWidget {
  final List<OrdenTrabajo> ordenes;
  final List<ProductoBase> inventario;
  final DatosNegocio datosNegocio;
  final Function(OrdenTrabajo, ProductoBase) onNuevaOrden;
  final VoidCallback onActualizar;

  const VistaOrdenesActivas({
    super.key,
    required this.ordenes,
    required this.inventario,
    required this.datosNegocio,
    required this.onNuevaOrden,
    required this.onActualizar,
  });

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: ordenes.isEmpty
          ? const Center(child: Text('No hay órdenes activas. Presiona + para crear una.'))
          : ListView.builder(
              itemCount: ordenes.length,
              itemBuilder: (context, index) {
                final orden = ordenes[index];
                return Card(
                  margin: const EdgeInsets.all(8.0),
                  child: Padding(
                    padding: const EdgeInsets.all(12.0),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          mainAxisAlignment: MainAxisAlignment.spaceBetween,
                          children: [
                            Text(orden.cliente, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
                            Chip(
                              label: Text(orden.estatusProduccion, style: const TextStyle(fontSize: 12)),
                              backgroundColor: orden.estatusProduccion == 'Pendiente de Surtir' ? Colors.orange[100] : Colors.blue[100],
                            ),
                          ],
                        ),
                        Text('Prenda: ${orden.productoNameDetalle()} (${orden.cantidad} pzas)'),
                        Text('Técnica: ${orden.tecnica} | Ubicación: ${orden.ubicacionLogo}', style: const TextStyle(fontWeight: FontWeight.w500)),
                        Text('Inventario: ${orden.estatusInventario}', style: TextStyle(color: orden.estatusInventario == 'Pendiente de surtir' ? Colors.red : Colors.green, fontWeight: FontWeight.bold)),
                        if (orden.imagenDisenoPath != null) ...[
                          const SizedBox(height: 5),
                          Row(
                            children: [
                              const Icon(Icons.image, size: 16, color: Colors.blue),
                              const SizedBox(width: 5),
                              const Text('Diseño adjunto registrado', style: TextStyle(fontSize: 12, fontStyle: FontStyle.italic)),
                            ],
                          ),
                        ],
                        const Divider(),
                        Row(
                          mainAxisAlignment: MainAxisAlignment.spaceBetween,
                          children: [
                            Text('Total: \$${orden.total.toStringAsFixed(2)}'),
                            Text('Anticipo: \$${orden.anticipo.toStringAsFixed(2)}'),
                            Text('Restante: \$${orden.restante.toStringAsFixed(2)}', style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.red)),
                          ],
                        ),
                        const SizedBox(height: 10),
                        Wrap(
                          spacing: 8,
                          children: [
                            ElevatedButton.icon(
                              onPressed: () {
                                if (orden.estatusProduccion == 'Pendiente de Surtir') {
                                  orden.estatusProduccion = 'En Producción';
                                  orden.estatusInventario = 'Surtido';
                                } else if (orden.estatusProduccion == 'En Producción') {
                                  orden.estatusProduccion = 'Listo';
                                } else if (orden.estatusProduccion == 'Listo') {
                                  orden.estatusProduccion = 'Entregado';
                                }
                                onActualizar();
                              },
                              icon: const Icon(Icons.update, size: 16),
                              label: Text(orden.estatusProduccion == 'Pendiente de Surtir' ? 'Marcar Surtido' : 'Avanzar Estatus'),
                            ),
                            IconButton(
                              icon: const Icon(Icons.chat, color: Colors.green),
                              onPressed: () => _enviarWhatsApp(orden),
                              tooltip: 'Enviar WhatsApp',
                            ),
                            IconButton(
                              icon: const Icon(Icons.picture_as_pdf, color: Colors.red),
                              onPressed: () => _generarYCompartirPDF(orden, datosNegocio),
                              tooltip: 'Compartir PDF de 2 Hojas',
                            ),
                          ],
                        )
                      ],
                    ),
                  ),
                );
              },
            ),
      floatingActionButton: FloatingActionButton(
        onPressed: () => _mostrarFormularioNuevaOrden(context),
        child: const Icon(Icons.add),
      ),
    );
  }

  void _mostrarFormularioNuevaOrden(BuildContext context) {
    final clienteController = TextEditingController();
    final telefonoController = TextEditingController();
    final cantidadController = TextEditingController();
    final totalController = TextEditingController();
    final anticipoController = TextEditingController();
    
    ProductoBase? productoSeleccionado;
    String colorSeleccionado = '';
    String tallaSeleccionada = '';
    String tecnicaSeleccionada = 'Bordado';
    String ubicacionSeleccionada = 'Pecho';
    String? imagenDisenoPath;

    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      builder: (context) {
        return Padding(
          padding: EdgeInsets.only(bottom: MediaQuery.of(context).viewInsets.bottom, left: 16, right: 16, top: 16),
          child: StatefulBuilder(
            builder: (context, setStateModal) {
              return SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    const Text('Nueva Orden de Trabajo', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
                    TextField(controller: clienteController, decoration: const InputDecoration(labelText: 'Nombre del Cliente')),
                    TextField(controller: telefonoController, decoration: const InputDecoration(labelText: 'Teléfono (WhatsApp)'), keyboardType: TextInputType.phone),
                    
                    // Selección de Producto Base
                    DropdownButtonFormField<ProductoBase>(
                      hint: const Text('Seleccionar Modelo de Prenda'),
                      items: inventario.map((p) => DropdownMenuItem(value: p, child: Text('${p.nombre} (\$${p.precioBase})'))).toList(),
                      onChanged: (val) {
                        setStateModal(() {
                          productoSeleccionado = val;
                          if (val != null && val.coloresDisponibles.isNotEmpty) {
                            colorSeleccionado = val.coloresDisponibles.first;
                          }
                          if (val != null && val.tallasDisponibles.isNotEmpty) {
                            tallaSeleccionada = val.tallasDisponibles.first;
                          }
                          totalController.text = val?.precioBase.toString() ?? '';
                        });
                      },
                    ),

                    // Variación Manual de Color (si hay producto seleccionado)
                    if (productoSeleccionado != null) ...[
                      const SizedBox(height: 10),
                      DropdownButtonFormField<String>(
                        value: colorSeleccionado.isEmpty ? null : colorSeleccionado,
                        hint: const Text('Seleccionar Color'),
                        items: productoSeleccionado!.coloresDisponibles.map((c) => DropdownMenuItem(value: c, child: Text(c))).toList(),
                        onChanged: (val) => setStateModal(() => colorSeleccionado = val!),
                      ),
                      const SizedBox(height: 10),
                      DropdownButtonFormField<String>(
                        value: tallaSeleccionada.isEmpty ? null : tallaSeleccionada,
                        hint: const Text('Seleccionar Talla'),
                        items: productoSeleccionado!.tallasDisponibles.map((t) => DropdownMenuItem(value: t, child: Text(t))).toList(),
                        onChanged: (val) => setStateModal(() => tallaSeleccionada = val!),
                      ),
                    ],

                    TextField(controller: cantidadController, decoration: const InputDecoration(labelText: 'Cantidad'), keyboardType: TextInputType.number),
                    
                    DropdownButtonFormField<String>(
                      value: tecnicaSeleccionada,
                      items: ['Bordado', 'Sublimado', 'DTF', 'Serigrafía'].map((t) => DropdownMenuItem(value: t, child: Text(t))).toList(),
                      onChanged: (val) => setStateModal(() => tecnicaSeleccionada = val!),
                    ),
                    
                    DropdownButtonFormField<String>(
                      value: ubicacionSeleccionada,
                      items: ['Pecho', 'Espalda', 'Manga Derecha', 'Manga Izquierda'].map((u) => DropdownMenuItem(value: u, child: Text(u))).toList(),
                      onChanged: (val) => setStateModal(() => ubicacionSeleccionada = val!),
                    ),

                    TextField(controller: totalController, decoration: const InputDecoration(labelText: 'Total de la Orden \$'), keyboardType: TextInputType.number),
                    TextField(controller: anticipoController, decoration: const InputDecoration(labelText: 'Anticipo Recibido \$'), keyboardType: TextInputType.number),
                    
                    const SizedBox(height: 10),
                    ElevatedButton.icon(
                      onPressed: () async {
                        final picker = ImagePicker();
                        final image = await picker.pickImage(source: ImageSource.gallery);
                        if (image != null) {
                          setStateModal(() => imagenDisenoPath = image.path);
                        }
                      },
                      icon: const Icon(Icons.camera_alt),
                      label: Text(imagenDisenoPath == null ? 'Subir Foto del Diseño' : 'Diseño Adjuntado ✓'),
                    ),

                    const SizedBox(height: 20),
                    ElevatedButton(
                      onPressed: () {
                        if (clienteController.text.isEmpty || productoSeleccionado == null || cantidadController.text.isEmpty) return;
                        
                        int cant = int.parse(cantidadController.text);
                        double tot = double.tryParse(totalController.text) ?? 0.0;
                        double ant = double.tryParse(anticipoController.text) ?? 0.0;

                        OrdenTrabajo nueva = OrdenTrabajo(
                          id: DateTime.now().millisecondsSinceEpoch.toString(),
                          cliente: clienteController.text,
                          telefono: telefonoController.text,
                          productoNombre: productoSeleccionado!.nombre,
                          colorSeleccionado: colorSeleccionado,
                          tallaSeleccionada: tallaSeleccionada,
                          cantidad: cant,
                          total: tot,
                          anticipo: ant,
                          tecnica: tecnicaSeleccionada,
                          ubicacionLogo: ubicacionSeleccionada,
                          imagenDisenoPath: imagenDisenoPath,
                          estatusProduccion: 'En Producción',
                          estatusInventario: 'Surtido',
                          fecha: DateTime.now(),
                        );

                        onNuevaOrden(nueva, productoSeleccionado!);
                        Navigator.pop(context);
                        onActualizar();
                      },
                      child: const Text('Guardar Orden'),
                    ),
                    const SizedBox(height: 20),
                  ],
                ),
              );
            },
          ),
        );
      },
    );
  }

  Future<void> _enviarWhatsApp(OrdenTrabajo orden) async {
    final String mensaje = '''
*UNITAP - Resumen de Pedido*
Hola *${orden.cliente}*, este es el detalle de tu orden:
• Prenda: ${orden.productoNombre} (${orden.colorSeleccionado}, Talla ${orden.tallaSeleccionada}) x ${orden.cantidad} pzas
• Técnica / Ubicación: ${orden.tecnica} en *${orden.ubicacionLogo}*
• Estatus: *${orden.estatusProduccion}*
• Total: \$${orden.total.toStringAsFixed(2)}
• Anticipo: \$${orden.anticipo.toStringAsFixed(2)}
• Restante: \$${orden.restante.toStringAsFixed(2)}
''';
    final Uri url = Uri.parse('https://wa.me/${orden.telefono.replaceAll(RegExp(r'\D'), '')}?text=${Uri.encodeComponent(mensaje)}');
    if (await canLaunchUrl(url)) await launchUrl(url, mode: LaunchMode.externalApplication);
  }

  // --- GENERACIÓN DE PDF DE 2 HOJAS (INCLUYENDO FOTO DE DISEÑO) ---
  Future<void> _generarYCompartirPDF(OrdenTrabajo orden, DatosNegocio negocio) async {
    final pdf = pw.Document();

    pw.ImageProvider? logoNegocioImage;
    if (negocio.logoPath != null) {
      final file = File(negocio.logoPath!);
      if (file.existsSync()) logoNegocioImage = pw.MemoryImage(file.readAsBytesSync());
    }

    pw.ImageProvider? fotoDisenoImage;
    if (orden.imagenDisenoPath != null) {
      final file = File(orden.imagenDisenoPath!);
      if (file.existsSync()) fotoDisenoImage = pw.MemoryImage(file.readAsBytesSync());
    }

    // HOJA 1: NOTA DE PEDIDO Y FINANZAS
    pdf.addPage(pw.Page(
      build: (context) => pw.Column(
        crossAxisAlignment: pw.CrossAxisAlignment.start,
        children: [
          pw.Row(
            mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
            children: [
              pw.Column(
                crossAxisAlignment: pw.CrossAxisAlignment.start,
                children: [
                  pw.Text(negocio.nombre, style: pw.TextStyle(fontSize: 20, fontWeight: pw.FontBold)),
                  pw.Text("Tel: ${negocio.telefono}", style: const pw.TextStyle(fontSize: 12)),
                  pw.Text(negocio.direccion, style: const pw.TextStyle(fontSize: 12)),
                ],
              ),
              if (logoNegocioImage != null) pw.Container(width: 50, height: 50, child: pw.Image(logoNegocioImage)),
            ],
          ),
          pw.Divider(thickness: 2),
          pw.SizedBox(height: 10),
          pw.Text("NOTA DE PEDIDO", style: pw.TextStyle(fontSize: 16, fontWeight: pw.FontBold)),
          pw.SizedBox(height: 5),
          pw.Text("Cliente: ${orden.cliente}"),
          pw.Text("Fecha: ${orden.fecha.day}/${orden.fecha.month}/${orden.fecha.year}"),
          pw.Text("Estatus: ${orden.estatusProduccion}"),
          pw.SizedBox(height: 15),
          pw.Table.fromTextArray(
            headers: ['Cant.', 'Prenda / Color / Talla', 'Técnica', 'Ubicación'],
            data: [
              ['${orden.cantidad}', '${orden.productoNameDetalle()}', orden.tecnica, orden.ubicacionLogo],
            ],
          ),
          pw.SizedBox(height: 20),
          pw.Divider(),
          pw.Row(
            mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
            children: [
              pw.Text("Total de la Orden:"),
              pw.Text("\$${orden.total.toStringAsFixed(2)}"),
            ],
          ),
          pw.Row(
            mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
            children: [
              pw.Text("Anticipo Recibido:"),
              pw.Text("\$${orden.anticipo.toStringAsFixed(2)}"),
            ],
          ),
          pw.Row(
            mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
            children: [
              pw.Text("Restante a Pagar:", style: pw.TextStyle(fontWeight: pw.FontBold)),
              pw.Text("\$${orden.restante.toStringAsFixed(2)}", style: pw.TextStyle(fontWeight: pw.FontBold, color: PdfColors.red)),
            ],
          ),
        ],
      ),
    ));

    // HOJA 2: GUÍA DE BORDADO E IMAGEN DEL DISEÑO
    pdf.addPage(pw.Page(
      build: (context) => pw.Column(
        crossAxisAlignment: pw.CrossAxisAlignment.center,
        children: [
          pw.Text("GUÍA DE PRODUCCIÓN Y DISEÑO", style: pw.TextStyle(fontSize: 18, fontWeight: pw.FontBold)),
          pw.SizedBox(height: 5),
          pw.Text("Cliente: ${orden.cliente} | Prenda: ${orden.colorSeleccionado}, Talla ${orden.tallaSeleccionada}", style: const pw.TextStyle(fontSize: 12)),
          pw.Divider(),
          pw.SizedBox(height: 10),
          pw.Container(
            padding: const pw.EdgeInsets.all(10),
            decoration: pw.BoxDecoration(
              border: pw.Border.all(color: PdfColors.blue, width: 2),
              borderRadius: const pw.BorderRadius.all(pw.Radius.circular(8)),
            ),
            child: pw.Column(
              children: [
                pw.Text("UBICACIÓN SELECCIONADA:", style: pw.TextStyle(fontSize: 12, fontWeight: pw.FontBold)),
                pw.Text("➔ ${orden.ubicacionLogo.toUpperCase()}", style: pw.TextStyle(fontSize: 18, fontWeight: pw.FontBold, color: PdfColors.blue800)),
                pw.Text("Técnica: ${orden.tecnica}", style: const pw.TextStyle(fontSize: 12)),
              ],
            ),
          ),
          pw.SizedBox(height: 20),
          pw.Text("FOTO DEL DISEÑO A ESTAMPAR / BORDAR:", style: pw.TextStyle(fontSize: 12, fontWeight: pw.FontBold)),
          pw.SizedBox(height: 10),
          if (fotoDisenoImage != null)
            pw.Container(
              height: 180,
              width: 180,
              child: pw.Image(fotoDisenoImage),
            )
          else
            pw.Text("No se adjuntó imagen del diseño para esta orden.", style: const pw.TextStyle(fontStyle: pw.FontStyle.italic)),
          const pw.Spacer(),
          pw.Text("Taller UNITAP - Control Interno", style: const pw.TextStyle(fontSize: 10, color: PdfColors.grey700)),
        ],
      ),
    ));

    final output = await getTemporaryDirectory();
    final file = File("${output.path}/orden_${orden.cliente}.pdf");
    await file.writeAsBytes(await pdf.save());
    await Share.shareXFiles([XFile(file.path)], text: 'Nota de Pedido y Guía de Logo - ${orden.cliente}');
  }
}

extension OrdenExt on OrdenTrabajo {
  String productoNameDetalle() => '$productoNombre (${colorSeleccionado}, Talla $tallaSeleccionada)';
}

// --- VISTA 2: HISTORIAL DE PEDIDOS FINALIZADOS ---
class VistaHistorialMes extends StatefulWidget {
  final List<OrdenTrabajo> ordenes;
  const VistaHistorialMes({super.key, required this.ordenes});

  @override
  State<VistaHistorialMes> createState() => _VistaHistorialMesState();
}

class _VistaHistorialMesState extends State<VistaHistorialMes> {
  int _mesSeleccionado = DateTime.now().month;
  int _anioSeleccionado = DateTime.now().year;

  final List<String> _meses = [
    'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
  ];

  @override
  Widget build(BuildContext context) {
    final ordenesFiltradas = widget.ordenes.where((o) => o.fecha.month == _mesSeleccionado && o.fecha.year == _anioSeleccionado).toList();

    return Column(
      children: [
        Padding(
          padding: const EdgeInsets.all(8.0),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              const Text('Seleccionar Mes: '),
              DropdownButton<int>(
                value: _mesSeleccionado,
                items: List.generate(12, (index) => DropdownMenuItem(value: index + 1, child: Text(_meses[index]))),
                onChanged: (val) => setState(() => _mesSeleccionado = val!),
              ),
            ],
          ),
        ),
        Expanded(
          child: ordenesFiltradas.isEmpty
              ? const Center(child: Text('No hay pedidos finalizados en este mes.'))
              : ListView.builder(
                  itemCount: ordenesFiltradas.length,
                  itemBuilder: (context, index) {
                    final o = ordenesFiltradas[index];
                    return ListTile(
                      title: Text(o.cliente),
                      subtitle: Text('${o.productoNameDetalle()} (${o.ubicacionLogo}) - ${o.fecha.day}/${o.fecha.month}/${o.fecha.year}'),
                      trailing: Text('\$${o.total.toStringAsFixed(2)}', style: const TextStyle(fontWeight: FontWeight.bold)),
                    );
                  },
                ),
        ),
      ],
    );
  }
}

// --- VISTA 3: INVENTARIO / CATÁLOGO BASE ---
class VistaInventario extends StatelessWidget {
  final List<ProductoBase> inventario;
  final VoidCallback onActualizar;
  
  const VistaInventario({super.key, required this.inventario, required this.onActualizar});

  @override
  Widget build(BuildContext context) {
    return ListView.builder(
      itemCount: inventario.length,
      itemBuilder: (context, index) {
        final p = inventario[index];
        return Card(
          margin: const EdgeInsets.all(8.0),
          child: ListTile(
            title: Text(p.nombre, style: const TextStyle(fontWeight: FontWeight.bold)),
            subtitle: Text('Colores: ${p.coloresDisponibles.join(", ")}\nTallas: ${p.tallasDisponibles.join(", ")}\nPrecio Base: \$${p.precioBase.toStringAsFixed(2)}'),
            isThreeLine: true,
            trailing: Chip(
              label: Text('Stock: ${p.stockGeneral}'),
              backgroundColor: p.stockGeneral < 5 ? Colors.orange[100] : Colors.green[100],
            ),
          ),
        );
      },
    );
  }
}